<%- include('partials/header', { title: 'Projects', page: 'projects' }) %>

<div class="projects-page">
    <div class="page-header">
        <h2>Projects</h2>
        <button class="btn btn-primary" id="new-project-btn" aria-label="New project" title="New project">
            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14"/>
                <path d="M5 12h14"/>
            </svg>
        </button>
    </div>

    <div class="projects-list">
        <% projects.forEach(project => { %>
            <div class="project-card" data-project-id="<%= project.id %>" data-name="<%= project.name %>" data-description="<%= project.description %>">
                <div class="project-info">
                    <h3><%= project.name %></h3>
                    <p class="project-description"><%= project.description %></p>
                    <div class="project-meta">
                        <span class="file-count"><%= project.fileCount %> file<%= project.fileCount === 1 ? '' : 's' %></span>
                        <time data-updated="<%= project.updatedAt %>">updated recently</time>
                    </div>
                    <% if (project.recentFiles.length) { %>
                        <div class="recent-files">
                            <% project.recentFiles.forEach(f => { %>
                                <span class="recent-file">
                                    <a href="/writing?project=<%= project.id %>&file=<%= f.id %>"><%= f.path %></a>
                                    <button class="file-delete-btn" data-file-id="<%= f.id %>" aria-label="Delete <%= f.path %>" title="Delete file">
                                        <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M18 6L6 18"/>
                                            <path d="M6 6l12 12"/>
                                        </svg>
                                    </button>
                                </span>
                            <% }); %>
                        </div>
                    <% } %>
                    <% if (project.remainingFiles.length) { %>
                        <button class="project-expand-files-btn" aria-label="Show all files" aria-expanded="false" title="Show all files">
                            <svg class="icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M6 9l6 6 6-6"/>
                            </svg>
                            <span><%= project.remainingFiles.length %> more file<%= project.remainingFiles.length === 1 ? '' : 's' %></span>
                        </button>
                        <div class="all-files-list">
                            <div class="all-files-list-inner">
                                <% project.remainingFiles.forEach(f => { %>
                                    <a href="/writing?project=<%= project.id %>&file=<%= f.id %>"><%= f.path %></a>
                                <% }); %>
                            </div>
                        </div>
                    <% } %>
                </div>
                <div class="project-actions">
                    <a href="/writing?project=<%= project.id %>" class="btn btn-secondary" aria-label="Open <%= project.name %>" title="Open">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"/>
                            <path d="M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    <button class="btn project-edit-btn" aria-label="Rename <%= project.name %>" title="Rename">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9"/>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                        </svg>
                    </button>
                    <button class="btn project-delete-btn" aria-label="Delete <%= project.name %>" title="Delete">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M3 6h18"/>
                            <path d="M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>
                            <path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/>
                        </svg>
                    </button>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('partials/footer') %>
