<%- include('partials/header', { title: 'Projects', page: 'projects' }) %>

<div class="projects-page">
    <div class="page-header">
        <h2>Projects</h2>
        <button class="btn btn-primary" id="new-project-btn" aria-label="New project" title="New project">
            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 5v14"/>
                <path d="M5 12h14"/>
            </svg>
        </button>
    </div>

    <div class="projects-list">
        <% projects.forEach(project => { %>
            <div class="project-card" data-project-id="<%= project.id %>" data-name="<%= project.name %>" data-description="<%= project.description %>">
                <div class="project-info">
                    <h3><%= project.name %></h3>
                    <p class="project-description"><%= project.description %></p>
                    <div class="project-meta">
                        <span class="file-count"><%= project.fileCount %> file<%= project.fileCount === 1 ? '' : 's' %></span>
                        <time data-updated="<%= project.updatedAt %>">updated recently</time>
                    </div>
                    <% if (project.recentFiles.length) { %>
                        <div class="recent-files">
                            <% project.recentFiles.forEach(f => { %>
                                <span><%= f %></span>
                            <% }); %>
                        </div>
                    <% } %>
                </div>
                <div class="project-actions">
                    <a href="/writing?project=<%= project.id %>" class="btn btn-secondary" aria-label="Open <%= project.name %>" title="Open">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"/>
                            <path d="M13 6l6 6-6 6"/>
                        </svg>
                    </a>
                    <button class="btn project-edit-btn" aria-label="Rename <%= project.name %>" title="Rename">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 20h9"/>
                            <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>
                        </svg>
                    </button>
                </div>
            </div>
        <% }); %>
    </div>
</div>

<%- include('partials/footer') %>
