<!-- src/views/login.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in - Vellum</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/img/vellum-mark.svg" type="image/svg+xml">
</head>
<body data-page="login">
    <div class="app-container">
        <main class="app-main login-main">
            <form class="login-form" method="POST" action="/login">
                <h1 class="app-title login-title">vellum<span class="caret" aria-hidden="true"></span></h1>
                <input type="password" name="password" placeholder="Password" autocomplete="current-password" autofocus>
                <% if (error) { %>
                    <p class="login-error"><%= error %></p>
                <% } %>
                <button type="submit" class="btn btn-primary" aria-label="Sign in" title="Sign in">
                    <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M5 12h14"/>
                        <path d="M13 6l6 6-6 6"/>
                    </svg>
                </button>
            </form>
        </main>
    </div>
</body>
</html>
