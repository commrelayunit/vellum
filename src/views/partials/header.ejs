<!DOCTYPE html>
<html lang="en"<% if (theme === 'light' || theme === 'dark') { %> data-theme="<%= theme %>"<% } %>>
<head>
    <meta charset="UTF-8">
    <!-- Resolves an unset/"system" preference from the OS/browser before the
         stylesheet is even requested, so first paint never flashes the wrong
         theme. Runs only when the server didn't already render an explicit
         data-theme above (light/dark, from the signed-in user's saved
         preference) - "system" is deliberately left unresolved server-side
         since the server has no access to the browser's prefers-color-scheme. -->
    <script>
    (function() {
        if (document.documentElement.getAttribute('data-theme')) return;
        var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
    })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> - Vellum</title>
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" href="/img/vellum-mark.svg" type="image/svg+xml">
</head>
<body data-page="<%= page %>">
    <div class="app-container">
        <header class="app-header">
            <div class="header-left">
                <div class="menu-wrap">
                    <button class="menu-button" id="menu-toggle" aria-label="Menu" aria-haspopup="true" aria-expanded="false" title="Menu">
                        <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <circle cx="12" cy="5" r="1.4"/>
                            <circle cx="12" cy="12" r="1.4"/>
                            <circle cx="12" cy="19" r="1.4"/>
                        </svg>
                    </button>
                    <div class="menu-dropdown" id="menu-dropdown" role="menu" hidden>
                        <a href="/projects#new-project" class="menu-item" data-menu-action="new-project" role="menuitem">
                            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M12 5v14"/>
                                <path d="M5 12h14"/>
                            </svg>
                            <span>New project</span>
                        </a>
                        <a href="/projects" class="menu-item" data-menu-action="overview" role="menuitem">
                            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M4 11l8-7 8 7"/>
                                <path d="M6 10v9h12v-9"/>
                            </svg>
                            <span>Back to projects</span>
                        </a>
                        <a href="/settings" class="menu-item" data-menu-action="settings" role="menuitem">
                            <svg class="icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="12" cy="12" r="3"/>
                                <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                            </svg>
                            <span>Settings</span>
                        </a>
                    </div>
                </div>
                <h1 class="app-title">vellum<span class="caret" aria-hidden="true"></span></h1>
            </div>
            <div class="header-right">
                <select id="theme-select" aria-label="Theme" title="Theme">
                    <option value="system" <% if (theme !== 'light' && theme !== 'dark') { %>selected<% } %>>System</option>
                    <option value="light" <% if (theme === 'light') { %>selected<% } %>>Light</option>
                    <option value="dark" <% if (theme === 'dark') { %>selected<% } %>>Dark</option>
                </select>
            </div>
        </header>

        <main class="app-main">
