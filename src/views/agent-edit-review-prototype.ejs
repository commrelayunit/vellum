      </div>
      <p class="review-navigation"><button class="btn" id="previous-change" type="button" aria-label="Previous suggestion">←</button><span id="review-position">1 of 3</span><button class="btn" id="next-change" type="button" aria-label="Next suggestion">→</button></p>
      <div id="review-list" class="review-list" aria-live="polite"></div>
      <p class="review-empty" id="review-empty" hidden>No suggestions remain in this local preview.</p>
    </aside>
