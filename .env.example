# Port the server listens on.
PORT=3001

# Path to the SQLite database file. Created automatically on first run.
DB_PATH=./data/vellum.db

# Random secret used to sign session cookies. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=change-me-to-a-random-string

# Bcrypt hash of your login password — never the plaintext password itself.
# Generate with:
#   npm run hash-password -- "your chosen password"
AUTH_PASSWORD_HASH=

# Key used to encrypt/decrypt AI provider API keys stored in the database.
# Generate with:
#   openssl rand -base64 32
# Required before saving anything on the Settings page. Never change this
# once providers have been saved — their keys become permanently unreadable.
ENCRYPTION_KEY=

# NODE_ENV=production - set this in production deployments (e.g. via the systemd
# unit's Environment=, not this file) so Express disables dev-mode error pages
# and enables view caching. Leave unset for local development.
