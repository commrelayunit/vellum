{
  "name": "vellum",
  "version": "0.1.0",
  "description": "A private, self-hostable writing workspace for humans and agents",
  "main": "index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build:client": "esbuild src/client/editor-sync.js --bundle --outfile=src/public/js/editor-bundle.js",
    "dev:client": "esbuild src/client/editor-sync.js --bundle --outfile=src/public/js/editor-bundle.js --watch",
    "seed": "node src/scripts/seed.js",
    "hash-password": "node src/scripts/hash-password.js",
    "migrate": "node src/scripts/migrate.js",
    "update": "git pull && npm ci --omit=dev && npm run migrate",
    "test": "node --test"
  },
  "keywords": [
    "writing",
    "collaboration",
    "agent",
    "markdown",
    "self-hosted"
  ],
  "author": "Vellum Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^1.20.2",
    "dotenv": "^17.4.2",
    "ejs": "^3.1.9",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "openai": "^7.5.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "nodemon": "^3.0.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
